# 大模型 API（兼容 OpenAI 接口，默认示例用 DeepSeek）
OPENAI_API_KEY=sk-你的APIKey
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 本地向量模型（留空则自动在 HuggingFace 缓存里查找）
# 首次下载时临时加 EMBEDDING_ALLOW_DOWNLOAD=1，下完删掉即可离线运行
# EMBEDDING_MODEL_PATH=D:/models/Qwen3-Embedding-0.6B
# EMBEDDING_ALLOW_DOWNLOAD=1

# 设备：auto / cuda / cpu
EMBEDDING_DEVICE=auto
RERANKER_DEVICE=auto

# 重排模型（可选，留空自动查找 bge-reranker-base）
# RERANKER_MODEL_PATH=D:/models/bge-reranker-base
# MODEL_DIR=D:/models

# OCR（扫描版 PDF）
OCR_ENABLED=1

# 管理员查看原文的授权有效期（秒）
ADMIN_VIEW_MAX_AGE=600

# HuggingFace 镜像（国内网络建议保留）
HF_ENDPOINT=https://hf-mirror.com
