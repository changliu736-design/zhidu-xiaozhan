# ============================================================
# 智读小站 后端配置模板
#
# 用法：复制一份改名为 .env，然后把自己的值填进去
#     cp .env.example .env      （Windows: copy .env.example .env）
#
# 注意：.env 里全是密钥，不要提交到 git，也不要发到群里。
# ============================================================

# ------------------------------------------------------------
# 1) 生成模型（回答问题时用的大模型）
#    兼容 OpenAI 接口的国内服务都能填，推荐 DeepSeek（便宜、中文好）
# ------------------------------------------------------------
OPENAI_API_KEY=sk-你的DeepSeek密钥
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# ------------------------------------------------------------
# 2) 向量模型（把文章切块变成"可检索的向量"）
#    api   = 走云端接口（推荐；2核2G 服务器必须用这个）
#    local = 本地跑 Qwen3-Embedding-0.6B（需要 torch，吃 1.5G+ 内存）
#    auto  = 填了下面的 key 就走 api，否则 local
# ------------------------------------------------------------
EMBEDDING_PROVIDER=api

# 阿里云百炼（DashScope）的 OpenAI 兼容入口，国内服务器可直连
EMBEDDING_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-你的百炼密钥
EMBEDDING_API_MODEL=text-embedding-v3
# 向量维度：1024 与本地 Qwen3 一致；填 0 表示交给服务端决定
EMBEDDING_API_DIMENSIONS=1024
# 单次请求带几条文本（百炼 text-embedding-v3 上限 10 条，别调大）
EMBEDDING_API_BATCH_SIZE=10
EMBEDDING_API_TIMEOUT=30
EMBEDDING_API_RETRIES=3

# ------------------------------------------------------------
# 3) 重排模型（把召回的片段再精排一遍，提升答得准的概率）
#    api / local / off / auto
# ------------------------------------------------------------
RERANKER_PROVIDER=api
RERANKER_API_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 不填则自动复用上面的 EMBEDDING_API_KEY
# RERANKER_API_KEY=sk-你的百炼密钥
RERANKER_API_MODEL=gte-rerank-v2
RERANKER_API_TIMEOUT=20
# 设成 0 可以彻底关掉重排（召回质量会略降，但更快更省钱）
RERANKER_ENABLED=1

# ------------------------------------------------------------
# 4) 本地模型路径（仅 local 模式使用，api 模式可以全部忽略）
# ------------------------------------------------------------
# 首次下载时临时加 EMBEDDING_ALLOW_DOWNLOAD=1，下完删掉即可离线运行
# EMBEDDING_MODEL_PATH=D:/models/Qwen3-Embedding-0.6B
# EMBEDDING_ALLOW_DOWNLOAD=1
# RERANKER_MODEL_PATH=D:/models/bge-reranker-base
# MODEL_DIR=D:/models
# EMBEDDING_DEVICE=auto
# RERANKER_DEVICE=auto

# ------------------------------------------------------------
# 5) OCR（扫描版 PDF 才用到）
#    2核2G 服务器建议设 0：能省约 200M 内存峰值。
#    代价：纯图片扫描件读不出文字；有文字层的 PDF 不受影响。
# ------------------------------------------------------------
OCR_ENABLED=1

# ------------------------------------------------------------
# 6) 安全（上线前必须改掉这两个默认值）
# ------------------------------------------------------------
# 会话签名盐：随便一串 30 位以上的随机字符
SESSION_SALT=请改成随机字符串
# 管理员查看原文的授权签名盐：再换一串不同的
ADMIN_VIEW_SALT=请改成另一串随机字符串
# 管理员查看原文的授权有效期（秒）
ADMIN_VIEW_MAX_AGE=600

# 单文件上传上限（MB）。2核2G 服务器建议 20
MAX_CONTENT_LENGTH_MB=20

# HuggingFace 镜像（仅 local 模式下载模型时用到）
HF_ENDPOINT=https://hf-mirror.com
